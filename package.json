{
  "name": "stykanimate-mcp",
  "version": "1.0.1",
  "description": "Model Context Protocol (MCP) server for StykAnimate stick figure animation engine",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "stykanimate-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
