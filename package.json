  "repository": {
    "type": "git",
    "url": "git+https://github.com/jitendrakumar025/stykanimate-mcp.git"
  },
  "homepage": "https://github.com/jitendrakumar025/stykanimate-mcp#readme",
  "bugs": {
    "url": "https://github.com/jitendrakumar025/stykanimate-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@resvg/resvg-js": "^2.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
